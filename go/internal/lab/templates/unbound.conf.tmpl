# Generated by abhedctl. Patched Unbound ({{.S.Prefix}}/sbin/unbound), profile "{{.S.Profile}}"
server:
  interface: {{.S.ResolverAddr}}@{{.S.Port}}
  access-control: 127.0.0.0/8 allow
  username: ""
  chroot: ""
  directory: "{{.S.Dir}}"
  pidfile: "{{.S.Dir}}/run/unbound.pid"
  logfile: "{{.S.Dir}}/run/unbound.log"
  use-syslog: no
  verbosity: 1
  val-log-level: 2
  num-threads: 1
  do-not-query-localhost: no
  root-hints: "{{.S.Dir}}/etc/root.hints"
  trust-anchor-file: "{{.S.Dir}}/etc/trust-anchor.ds"
  edns-buffer-size: 1232
  extended-statistics: yes
  statistics-cumulative: no
{{- if .S.TCPUpstream}}
  tcp-upstream: yes
{{- end}}
{{- if .S.Tuned}}
  # fetch DNSKEY as soon as a DS is seen: the DNSKEY response carries the ladder (CSK layout)
  prefetch-key: yes
  # fewer speculative nameserver-address lookups before keys are known
  target-fetch-policy: "0 0 0 0 0"
{{- end}}
  # ABHED (patches/unbound): ML-DSA-44 and ML-DSA-44-MTL validation
{{- if eq .S.Profile "base"}}
  abhed-sigtag: no
  abhed-compact: no
{{- else if eq .S.Profile "sigtag"}}
  abhed-sigtag: yes
  abhed-compact: no
{{- else}}
  abhed-sigtag: yes
  abhed-compact: yes
{{- end}}
  abhed-ladder-cache-zones: 100000

remote-control:
  control-enable: yes
  control-interface: "{{.S.Dir}}/run/unbound.sock"
