# Generated by abhedctl. Patched NSD ({{.S.Prefix}}/sbin/nsd) serving {{.Srv.Zone}}
server:
  ip-address: {{.Srv.Addr}}@{{.S.Port}}
  username: ""
  zonesdir: "{{.S.Dir}}/zones"
  pidfile: "{{.S.Dir}}/run/nsd-{{.Srv.Name}}.pid"
  database: ""
  logfile: "{{.S.Dir}}/run/nsd-{{.Srv.Name}}.log"
  xfrdfile: "{{.S.Dir}}/run/xfrd-{{.Srv.Name}}.state"
  zonelistfile: "{{.S.Dir}}/run/zone-{{.Srv.Name}}.list"
  # 1232 bytes: the EDNS buffer size that avoids IP fragmentation (DNS Flag Day 2020)
  ipv4-edns-size: 1232
  ipv6-edns-size: 1232
  minimal-responses: yes
  server-count: 1
  verbosity: 1

remote-control:
  control-enable: yes
  control-interface: "{{.S.Dir}}/run/nsd-{{.Srv.Name}}.sock"

zone:
  name: "{{.Srv.Zone}}"
  zonefile: "{{.Srv.File}}"
  provide-xfr: 127.0.0.0/8 NOKEY
