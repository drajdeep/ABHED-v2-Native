 		/* RFC 6725 deprecates RSAMD5 */
@@ -741,6 +749,27 @@ verify_canonrrset(sldns_buffer* buf, int algo, unsigned char* sigblock,
 	int res, dofree = 0, docrypto_free = 0;
 	EVP_PKEY *evp_key = NULL;
 
+#ifdef USE_ABHED
+	if(algo == ABHED_ALG_MLDSA44 || algo == ABHED_ALG_MTL) {
+		size_t off = 0, sl;
+		int r;
+		sl = abhed_signing_data_signer(sldns_buffer_begin(buf),
+			sldns_buffer_limit(buf), &off);
+		if(!sl) {
+			*reason = "malformed signing data";
+			return sec_status_bogus;
+		}
+		r = abhed_verify_rrsig(algo, sldns_buffer_begin(buf),
+			sldns_buffer_limit(buf), sigblock, sigblock_len, key,
+			keylen, sldns_buffer_begin(buf)+off, sl);
+		if(r == ABHED_OK)
+			return sec_status_secure;
+		verbose(VERB_QUERY, "verify: abhed: %s", abhed_result_str(r));
+		*reason = (char*)abhed_result_str(r);
