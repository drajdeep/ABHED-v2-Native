 	if(!env->anchors) {
 		log_err("out of memory");
 		return 0;
@@ -685,6 +691,52 @@ prime_trust_anchor(struct module_qstate* qstate, struct val_qstate* vq,
 	return 1;
 }
 
+#ifdef USE_ABHED
+/** ABHED: 1 if the rrset carries an MTL RRSIG in full form (MTL-Type 0x01) */
+static int
+abhed_has_full_mtl(struct ub_packed_rrset_key* s)
+{
+	struct packed_rrset_data* d = (struct packed_rrset_data*)s->entry.data;
+	size_t i;
+	for(i=d->count; i<d->count+d->rrsig_count; i++) {
+		uint8_t* rd = d->rr_data[i];
+		size_t len = d->rr_len[i], p = 2+18;
+		if(len < p+1 || rd[2+2] != ABHED_ALG_MTL)
+			continue;
+		while(p < len && rd[p] != 0 && rd[p] <= 63)
+			p += (size_t)rd[p]+1;
+		p++;
+		if(p < len && rd[p] == ABHED_T_FULL)
+			return 1;
+	}
+	return 0;
+}
+
+/** ABHED: a response may carry the signed ladder in one RRSIG only (SigTag
+ * deduplication). Verify those RRsets first, so the ladder is in the cache
+ * before the condensed signatures of the same response are checked. */
+static void
+abhed_prevalidate(struct module_qstate* qstate, struct val_qstate* vq,
+	struct module_env* env, struct val_env* ve,
+	struct reply_info* chase_reply, struct key_entry_key* key_entry)
+{
+	size_t i;
+	char* reason = NULL;
+	sldns_ede_code rb = LDNS_EDE_NONE;
+	int verified = 0;
+	char rbuf[256];
+	for(i=0; i<chase_reply->an_numrrsets+chase_reply->ns_numrrsets; i++) {
+		struct ub_packed_rrset_key* s = chase_reply->rrsets[i];
+		if(!abhed_has_full_mtl(s))
+			continue;
+		(void)val_verify_rrset_entry(env, ve, s, key_entry, &reason,
+			&rb, i<chase_reply->an_numrrsets?LDNS_SECTION_ANSWER:
+			LDNS_SECTION_AUTHORITY, qstate, vq, &verified, rbuf,
+			sizeof(rbuf));
+	}
+}
+#endif /* USE_ABHED */
+
 /**
  * Validate if the ANSWER and AUTHORITY sections contain valid rrsets.
  * They must be validly signed with the given key.
@@ -727,6 +779,10 @@ validate_msg_signatures(struct module_qstate* qstate, struct val_qstate* vq,
 		vq->msg_signatures_state = 0;
 		have_state = 1;
 	}
+#ifdef USE_ABHED
+	if(!have_state)
+		abhed_prevalidate(qstate, vq, env, ve, chase_reply, key_entry);
+#endif
 
 	/* validate the ANSWER section */
 	for(i=0; i<chase_reply->an_numrrsets; i++) {
