diff --git a/rdata.c b/rdata.c
index ebd82e8..d7f0755 100644
--- a/rdata.c
+++ b/rdata.c
@@ -23,6 +23,7 @@
 #endif
 
 #include "rdata.h"
+#include "abhed_mtl.h"
 #include "zonec.h"
 #include "query.h"
 #include "dname.h"
@@ -2920,6 +2921,28 @@ read_rrsig_rdata(struct domain_table *domains, uint16_t rdlength,
 		return MALFORMED;
 	memrdlen = 18 + signer.dname.name_size;
 	b64len = rdlength - (buffer_position(packet) - mark);
+#ifdef USE_ABHED
+	/* ML-DSA-44-MTL: store the condensed signature, intern the signed ladder once */
+	if(b64len > 0) {
+		uint8_t* cbuf = (uint8_t*)malloc(b64len);
+		size_t clen = 0;
+		uint8_t alg = buffer_read_u8_at(packet, mark + 2);
+		if(cbuf && abhed_nsd_load_rrsig(alg, buffer_current(packet), b64len, cbuf, &clen)) {
+			if (!(*rr = region_alloc(domains->region, sizeof(**rr) + memrdlen + clen))) {
+				free(cbuf);
+				return TRUNCATED;
+			}
+			buffer_read_at(packet, mark, (*rr)->rdata, 18);
+			memcpy((*rr)->rdata + 18, dname_name((void*)&signer), signer.dname.name_size);
+			memcpy((*rr)->rdata + memrdlen, cbuf, clen);
+			buffer_skip(packet, b64len);
+			(*rr)->rdlength = memrdlen + clen;
+			free(cbuf);
+			return rdlength;
+		}
+		free(cbuf);
+	}
+#endif
 	if (!(*rr = region_alloc(domains->region, sizeof(**rr) + memrdlen + b64len)))
 		return TRUNCATED;
 	buffer_read_at(packet, mark, (*rr)->rdata, 18);
