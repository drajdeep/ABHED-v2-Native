diff --git a/abhed_mtl.c b/abhed_mtl.c
new file mode 100644
index 0000000..65437ba
--- /dev/null
+++ b/abhed_mtl.c
@@ -0,0 +1,177 @@
+/*
+ * Copyright 2026 Rajdeep Das, IEM-UEM, Kolkata, India
+ * SPDX-License-Identifier: Apache-2.0
+ * Part of ABHED-v2 (patch for NSD). See the LICENSE and NOTICE files of ABHED-v2.
+ */
+#include "config.h"
+#ifdef USE_ABHED
+#include <stdlib.h>
+#include <string.h>
+#include <abhed/abhed.h>
+#include "abhed_mtl.h"
+#include "buffer.h"
+#include "namedb.h"
+#include "query.h"
+#include "dns.h"
+#include "nsd.h"
+
+/* Interned signed ladders: one entry per series (SID), the largest ladder seen. Populated
+ * while zones are loaded (before serving processes fork), read-only while answering. */
+struct lentry {
+    uint8_t sid[ABHED_SID_LEN];
+    uint64_t n;
+    uint8_t *bytes;           /* signed ladder: ladder | siglen | signature */
+    size_t len;
+};
+#define MAX_SERIES 4096
+static struct lentry table[MAX_SERIES];
+static size_t ntable;
+static struct abhed_nsd_stats st;
+
+static struct lentry *find(const uint8_t *sid)
+{
+    for (size_t i = 0; i < ntable; i++)
+        if (memcmp(table[i].sid, sid, ABHED_SID_LEN) == 0) return &table[i];
+    return NULL;
+}
+
+int abhed_nsd_load_rrsig(uint8_t alg, const uint8_t *sig, size_t siglen, uint8_t *buf, size_t *outlen)
+{
+    if (alg != ABHED_ALG_MTL || siglen < 1 || sig[0] != ABHED_T_FULL) return 0;
+    abhed_cond c;
+    abhed_ladder l;
+    const uint8_t *ls;
+    size_t lsl;
+    size_t n = abhed_cond_decode(&c, sig + 1, siglen - 1);
+    if (!n) return 0;
+    size_t m = abhed_signed_ladder_decode(&l, &ls, &lsl, sig + 1 + n, siglen - 1 - n);
+    if (!m || 1 + n + m != siglen || memcmp(l.sid, c.sid, ABHED_SID_LEN)) return 0;
+    struct lentry *e = find(l.sid);
+    uint64_t ln = abhed_ladder_n(&l);
+    if (!e) {
+        if (ntable == MAX_SERIES) return 0;
+        e = &table[ntable++];
+        memcpy(e->sid, l.sid, ABHED_SID_LEN);
+        st.ladders = ntable;
+    }
+    if (!e->bytes || ln > e->n) {
+        uint8_t *b = malloc(m);
+        if (!b) return 0;
+        memcpy(b, sig + 1 + n, m);
+        free(e->bytes);
+        e->bytes = b; e->len = m; e->n = ln;
+    }
+    buf[0] = ABHED_T_COND;
+    memcpy(buf + 1, sig + 1, n);
+    *outlen = 1 + n;
+    return 1;
+}
+
+static size_t signer_len(const uint8_t *rd, size_t rdlen)
+{
+    size_t p = 18;
+    while (p < rdlen) {
+        uint8_t lab = rd[p];
+        if (lab > 63) return 0;
+        p += 1 + lab;
+        if (!lab) return p - 18;
+    }
+    return 0;
+}
+
+int abhed_nsd_is_mtl(const struct rr *rr)
+{
+    if (rr->type != TYPE_RRSIG || rr->rdlength < 20 || rr->rdata[2] != ABHED_ALG_MTL) return 0;
+    size_t sl = signer_len(rr->rdata, rr->rdlength);
+    return sl && 18 + sl < rr->rdlength && rr->rdata[18 + sl] == ABHED_T_COND;
+}
+
+int abhed_nsd_option(struct query *q, uint16_t code, const uint8_t *data, uint16_t len)
+{
+    if (code == ABHED_OPT_SIGTAG) {
+        if (len % ABHED_TAG_LEN || len / ABHED_TAG_LEN > ABHED_MAX_TAGS) return 0;   /* FORMERR */
+        if (!q->abhed_sigtag) q->edns.opt_reserved_space += 4;                       /* echo */
+        q->abhed_sigtag = 1;
+        q->abhed_ntags = len / ABHED_TAG_LEN;
+        memcpy(q->abhed_tags, data, len);
+    } else if (code == ABHED_OPT_ABHED) {
+        q->abhed_flags = len ? data[0] : 0;
+    }
+    return 1;
+}
+
+static uint64_t get64(const uint8_t *p) { uint64_t v = 0; for (int i = 0; i < 8; i++) v = (v << 8) | p[i]; return v; }
+
+static void write_cond(struct query *q, const abhed_cond *c, int compact)
+{
+    uint8_t out[1 + ABHED_COND_FIXED + 16 * ABHED_MAX_SIBS];
+    size_t n;
+    if (compact) {
+        n = abhed_compact_encode(c, out, sizeof out);
+        st.compact++; q->abhed_n[2]++;
+    } else {
+        out[0] = ABHED_T_COND;
+        n = 1 + abhed_cond_encode(c, out + 1, sizeof out - 1);
+        st.condensed++; q->abhed_n[1]++;
+    }
+    buffer_write(q->packet, out, n);
+}
+
+void abhed_nsd_write_rrsig(struct query *q, const struct rr *rr)
+{
+    size_t sl = signer_len(rr->rdata, rr->rdlength);
+    const uint8_t *sig = rr->rdata + 18 + sl;
+    size_t siglen = rr->rdlength - 18 - sl;
+    abhed_cond c;
+    buffer_write(q->packet, rr->rdata, 18 + sl);       /* header + uncompressed signer */
+    struct lentry *e = NULL;
+    if (!abhed_cond_decode(&c, sig + 1, siglen - 1) || !(e = find(c.sid))) {
+        buffer_write(q->packet, sig, siglen);
+        return;
+    }
+    int compact = (q->abhed_flags & ABHED_F_COMPACT) != 0;
+    if (q->abhed_sigtag) {
+        int best = -1;
+        abhed_cond bc;
+        for (int i = 0; i < q->abhed_ntags; i++) {
+            const uint8_t *t = q->abhed_tags + ABHED_TAG_LEN * i;
+            uint64_t right = get64(t + ABHED_SID_LEN);
+            if (memcmp(t, c.sid, ABHED_SID_LEN) || c.leaf > right || right >= e->n) continue;
+            abhed_cond tc = c;
+            if ((q->abhed_flags & ABHED_F_TRIM) && !abhed_cond_trim(&tc, right + 1)) continue;
+            if (best < 0 || tc.nsibs < bc.nsibs) { bc = tc; best = i; }
+        }
+        if (best >= 0) {                               /* client holds a covering ladder */
+            if (bc.nsibs < c.nsibs) { st.trimmed++; q->abhed_n[4]++; }
+            write_cond(q, &bc, compact);
+            return;
+        }
+        if (q->abhed_full_sent && !memcmp(q->abhed_full_sid, c.sid, ABHED_SID_LEN)) {
+            st.dedup++; q->abhed_n[3]++;               /* ladder already in this response */
+            write_cond(q, &c, compact);
+            return;
+        }
+    }
+    /* full signature: 0x01 | condensed | signed ladder */
+    uint8_t t = ABHED_T_FULL;
+    buffer_write(q->packet, &t, 1);
+    buffer_write(q->packet, sig + 1, siglen - 1);
+    buffer_write(q->packet, e->bytes, e->len);
+    q->abhed_full_sent = 1;
+    memcpy(q->abhed_full_sid, c.sid, ABHED_SID_LEN);
+    st.full++; q->abhed_n[0]++;
+}
+
+void abhed_nsd_stats(struct abhed_nsd_stats *s) { *s = st; }
+
+void abhed_nsd_account(struct nsdst *t, const struct query *q, size_t bytes, int tcp)
+{
+    t->abhed_full += q->abhed_n[0];
+    t->abhed_cond += q->abhed_n[1];
+    t->abhed_compact += q->abhed_n[2];
+    t->abhed_dedup += q->abhed_n[3];
+    t->abhed_trim += q->abhed_n[4];
+    if (tcp) { t->qtcp++; t->bytes_tcp += bytes; }
+    else t->bytes_udp += bytes;
+}
+#endif
diff --git a/abhed_mtl.h b/abhed_mtl.h
new file mode 100644
index 0000000..370030c
--- /dev/null
+++ b/abhed_mtl.h
@@ -0,0 +1,32 @@
+/*
+ * Copyright 2026 Rajdeep Das, IEM-UEM, Kolkata, India
+ * SPDX-License-Identifier: Apache-2.0
+ * Part of ABHED-v2 (patch for NSD). See the LICENSE and NOTICE files of ABHED-v2.
+ */
+/* ML-DSA-44-MTL support for NSD: signed-ladder interning and per-query RRSIG composition. */
+#ifndef ABHED_MTL_H
+#define ABHED_MTL_H
+#ifdef USE_ABHED
+#include <stdint.h>
+#include <stddef.h>
+struct query;
+struct rr;
+struct buffer;
+
+/* Called by read_rrsig_rdata for every RRSIG. If sig is an MTL full signature (0x01), the
+ * signed ladder is interned and *out/*outlen receive the 0x02 condensed form to store
+ * (in buf, which must hold siglen bytes). Returns 1 if replaced, 0 to store sig unchanged. */
+int abhed_nsd_load_rrsig(uint8_t alg, const uint8_t *sig, size_t siglen, uint8_t *buf, size_t *outlen);
+/* 1 if rr is an RRSIG of the MTL algorithm stored in condensed form. */
+int abhed_nsd_is_mtl(const struct rr *rr);
+/* Write the RRSIG RDATA of rr, composing the MTL signature field for this query. */
+void abhed_nsd_write_rrsig(struct query *q, const struct rr *rr);
+/* EDNS: option handlers. Return 0 for FORMERR. */
+int abhed_nsd_option(struct query *q, uint16_t code, const uint8_t *data, uint16_t len);
+struct abhed_nsd_stats { uint64_t full, condensed, compact, trimmed, dedup, ladders; };
+void abhed_nsd_stats(struct abhed_nsd_stats *s);
+struct nsdst;
+/* Add this query's MTL counters and response size to the statistics block. */
+void abhed_nsd_account(struct nsdst *t, const struct query *q, size_t bytes, int tcp);
+#endif
+#endif
